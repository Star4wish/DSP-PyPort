<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <AssemblyName>DSP-PyPort</AssemblyName>
    <RootNamespace>DSPPyPort</RootNamespace>

    <Version>0.9.3</Version>
    <AssemblyVersion>0.9.3.0</AssemblyVersion>
    <FileVersion>0.9.3.0</FileVersion>
    <Authors>Star4wish</Authors>
    <Product>DSP-PyPort</Product>
    <Description>Pyanodons (Factorio) content port for Dyson Sphere Program (BepInEx plugin).</Description>
    <RepositoryUrl>https://github.com/Star4wish/DSP-PyPort</RepositoryUrl>
    <RepositoryType>git</RepositoryType>

    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <DebugType>none</DebugType>
    <Optimize>true</Optimize>
    <Deterministic>true</Deterministic>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <ProduceReferenceAssembly>false</ProduceReferenceAssembly>
    <AutoGenerateBindingRedirects>false</AutoGenerateBindingRedirects>
  </PropertyGroup>

  <PropertyGroup>
    <!-- 游戏目录：-p:DSPGameDir=... 优先；其次环境变量 DSP_GAME_DIR；否则探测 Steam 常见安装位置 -->
    <DSPGameDir Condition="'$(DSPGameDir)' == '' AND '$(DSP_GAME_DIR)' != ''">$(DSP_GAME_DIR)</DSPGameDir>
    <DSPGameDir Condition="'$(DSPGameDir)' == '' AND Exists('C:\Games\Steam\steamapps\common\Dyson Sphere Program\DSPGAME_Data\Managed')">C:\Games\Steam\steamapps\common\Dyson Sphere Program</DSPGameDir>
    <DSPGameDir Condition="'$(DSPGameDir)' == '' AND Exists('C:\Program Files (x86)\Steam\steamapps\common\Dyson Sphere Program\DSPGAME_Data\Managed')">C:\Program Files (x86)\Steam\steamapps\common\Dyson Sphere Program</DSPGameDir>
    <DSPGameDir Condition="'$(DSPGameDir)' == '' AND Exists('D:\Steam\steamapps\common\Dyson Sphere Program\DSPGAME_Data\Managed')">D:\Steam\steamapps\common\Dyson Sphere Program</DSPGameDir>
    <DSPGameDir Condition="'$(DSPGameDir)' == ''">C:\Games\Steam\steamapps\common\Dyson Sphere Program</DSPGameDir>
    <DSPManagedDir>$(DSPGameDir)\DSPGAME_Data\Managed</DSPManagedDir>
    <DSPBepInExCore>$(DSPGameDir)\BepInEx\core</DSPBepInExCore>
    <DSPPluginsDir>$(DSPGameDir)\BepInEx\plugins</DSPPluginsDir>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="obj\**\*.cs" />
    <Compile Remove="bin\**\*.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.2" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup Condition="Exists('$(DSPManagedDir)')">
    <Reference Include="Assembly-CSharp">
      <HintPath>$(DSPManagedDir)\Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine">
      <HintPath>$(DSPManagedDir)\UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(DSPManagedDir)\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.ImageConversionModule">
      <HintPath>$(DSPManagedDir)\UnityEngine.ImageConversionModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.InputLegacyModule">
      <HintPath>$(DSPManagedDir)\UnityEngine.InputLegacyModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.UI">
      <HintPath>$(DSPManagedDir)\UnityEngine.UI.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.TextRenderingModule">
      <HintPath>$(DSPManagedDir)\UnityEngine.TextRenderingModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.UIModule">
      <HintPath>$(DSPManagedDir)\UnityEngine.UIModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup Condition="Exists('$(DSPBepInExCore)')">
    <Reference Include="BepInEx">
      <HintPath>$(DSPBepInExCore)\BepInEx.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(DSPBepInExCore)\0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup Condition="Exists('$(DSPPluginsDir)')">
    <Reference Include="CommonAPI">
      <HintPath>$(DSPPluginsDir)\CommonAPI-CommonAPI\CommonAPI.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="LDBTool">
      <HintPath>$(DSPPluginsDir)\xiaoye97-LDBTool\LDBTool.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

</Project>
