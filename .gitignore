# ---------------------------------------------------------------------------
# Build output
# ---------------------------------------------------------------------------
bin/
obj/
*.user
*.suo
*.lock.json
.vs/

# ---------------------------------------------------------------------------
# Runtime evidence / raw game logs (large + machine specific)
# Keep curated excerpts under docs/ instead.
# ---------------------------------------------------------------------------
logs/
*.log

# Curated evidence exception: excerpts explicitly placed under docs/evidence/
!docs/evidence/
!docs/evidence/*.log
!docs/evidence/*.txt

# ---------------------------------------------------------------------------
# Local deployment / packaged artifacts
# Full content bundle (3876 files) is tracked as ONE archive under assets/
# (see assets/DSP-PyPort-content-*.zip); build.ps1 extracts it to build\content.
# GitHub Releases / dist zip stay out of git.
# ---------------------------------------------------------------------------
dist/
*.zip
deploy/
build/

# ...except the single bundled content archive used by build.ps1
!assets/
!assets/*.zip

# ---------------------------------------------------------------------------
# OS / editor junk
# ---------------------------------------------------------------------------
Thumbs.db
desktop.ini
.DS_Store
*.swp
*~

# ---------------------------------------------------------------------------
# Game installation copies (never commit game or mod binaries)
# ---------------------------------------------------------------------------
DSPGAME_Data/
BepInEx/
Dyson Sphere Program/
